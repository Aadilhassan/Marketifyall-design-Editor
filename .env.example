# Marketifyall Design Editor - Environment Variables
# Copy this file to .env and fill in your values

# ─── Frontend (included in browser bundle) ───────────────────
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL (Supabase Edge Functions)
# Local dev: http://localhost:54321/functions/v1
# Production: https://your-project.supabase.co/functions/v1
REACT_APP_API_URL=http://localhost:54321/functions/v1

# Environment (development | production)
REACT_APP_ENVIRONMENT=development

# Stock photo APIs (optional)
REACT_APP_PEXELS_KEY=
REACT_APP_PIXABAY_KEY=

# ─── Backend Only (Supabase Edge Function secrets) ───────────
# These are NOT in the frontend bundle. Set via: supabase secrets set KEY=VALUE
#
# OPENROUTER_API_KEY=          # AI provider API key
# STRIPE_SECRET_KEY=           # Stripe secret key
# STRIPE_WEBHOOK_SECRET=       # Stripe webhook signing secret
# STRIPE_PRICE_CREATOR=        # Stripe price ID for Creator plan
# STRIPE_PRICE_PRO=            # Stripe price ID for Pro plan
# STRIPE_PRICE_STARTER=        # Stripe price ID for Starter top-up
# STRIPE_PRICE_GROWTH=         # Stripe price ID for Growth top-up
# STRIPE_PRICE_POWER=          # Stripe price ID for Power top-up
# CMS_TOKEN_ENCRYPTION_KEY=    # AES-256 key for encrypting CMS tokens
