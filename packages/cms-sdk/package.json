{
  "name": "@marketifyall/cms-sdk",
  "version": "0.1.0",
  "description": "Universal SDK for integrating Marketifyall Design Editor into any CMS platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "keywords": ["design-editor", "cms", "webflow", "shopify", "wordpress", "canva-alternative"],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
