{
  "name": "@marketifyall/embed",
  "version": "0.1.0",
  "description": "One-line embeddable design editor for any website",
  "main": "dist/embed.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/embed.ts --format iife --global-name Marketifyall --minify --clean --out-dir dist",
    "dev": "tsup src/embed.ts --format iife --global-name Marketifyall --watch --out-dir dist"
  },
  "license": "MIT",
  "devDependencies": {
    "@marketifyall/cms-sdk": "workspace:*",
    "@marketifyall/quick-actions": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
